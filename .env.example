# ============================================================================
# GENEL ŞABLON (production / varsayılan). Bu dosyayı `.env` olarak kopyalayıp
# değerleri doldurun. Ortam-özel dosyalar için: .env.production.example, .env.dev.example
# (bkz. ENVIRONMENTS.md). Gerçek değerler .env* dosyalarında tutulur, repoya GİRMEZ.
# ============================================================================

# Ortam seçimi. Boş bırakılırsa production varsayılanı kullanılır.
# Genellikle bunu elle set etmezsiniz; `npm run test:prod` / `npm run test:dev`
# scriptleri TEST_ENV'i otomatik ayarlar (bkz. ENVIRONMENTS.md).
TEST_ENV=production
# BASE_URL zorunlu DEĞİL: TEST_ENV kaydından (config/environments.js) türetilir.
# Yalnızca özel bir host'a yönlendirmek isterseniz açın:
# BASE_URL=https://app.vomenta.com

# Mutation testleri YALNIZCA staging'de ve ayrılmış tenant'ta çalışır.
# Production ve dev için kaçış bayrağı/komutu yoktur (salt-okunur).
ALLOW_MUTATING_TESTS=false

# ── STAGING MUTATION BLOĞU (lokal @mutation koşumu için) ──────────────────────
# Lokal olarak `npm run test:mutation` çalıştırmak için aşağıdaki 6 satırın
# yorumunu kaldırıp staging değerlerini girin, ALLOW_MUTATING_TESTS=true yapın ve
# üstteki TEST_ENV/BASE_URL'i staging'e çevirin. Kurulum rehberi:
#   docs/MUTATION-STAGING-SETUP.md
# Doğrulama:  npm run mutation:preflight   (secret sızdırmadan tüm kapıları denetler)
# CI'da bu değerler .env'de DEĞİL, GitHub `staging` Environment'ında tutulur.
# TEST_ENV=staging
# BASE_URL=https://<staging-app-host>
# MUTATION_API_ORIGIN=https://<staging-api-host>          # yalnız origin, path YOK
# MUTATION_TENANT_ID=<staging-tenant-uuid>                # UUID biçimi zorunlu
# MUTATION_TENANT_SLUG=<staging-tenant-slug>
# ──────────────────────────────────────────────────────────────────────────────

# Varsayılan otomasyon hesabı (production için kendi hesabınız).
VOMENTA_EMAIL=automation@example.com
# Placeholder — GERÇEK parola koymayın; kendi .env dosyanıza yazın.
VOMENTA_PASSWORD=REPLACE_WITH_YOUR_PASSWORD
# Giriş yapan kullanıcının başlıkta göründüğü ad (AppShell doğrulaması için).
# Her ortamda o ortamdaki hesabın adını yazın.
VOMENTA_USER_DISPLAY_NAME=Test User

# Yalnızca STAGING E2E arama/SMS testleri için AYRILMIŞ test numarası (E.164, ör. +90555...).
# Boşsa ilgili testler atlanır. Kişisel numara koyma; repoya GİRMEZ (.env gitignore'lu).
# VOMENTA_TEST_PHONE=

# Rol bazlı testler devreye alındığında kullanılacak isteğe bağlı hesaplar
# VOMENTA_ADMIN_EMAIL=
# VOMENTA_ADMIN_PASSWORD=
# VOMENTA_SUPERVISOR_EMAIL=
# VOMENTA_SUPERVISOR_PASSWORD=
# VOMENTA_AGENT_EMAIL=
# VOMENTA_AGENT_PASSWORD=

# Yalnızca STAGING E2E agent UI testleri için AYRILMIŞ agent e-maili (ör. user@example.com).
# Boşsa ilgili testler atlanır.
# VOMENTA_TEST_AGENT_EMAIL=

# Yalnızca STAGING E2E arama/SMS testleri için AYRILMIŞ test numarası (E.164 formatında).
# Boşsa ilgili testler atlanır. Kişisel numara koyma; repoya GİRMEZ (.env gitignore'lu).
# VOMENTA_TEST_CONTACT_PHONE=

# İsteğe bağlı çalışma ayarları
# PLAYWRIGHT_WORKERS=4
# PLAYWRIGHT_RETRIES=1
# PLAYWRIGHT_ACTION_TIMEOUT=15000
# PLAYWRIGHT_NAVIGATION_TIMEOUT=30000
# PLAYWRIGHT_EXPECT_TIMEOUT=15000
