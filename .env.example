# Ortam politikası (salt-okunur testler production'da çalışabilir)
TEST_ENV=production
BASE_URL=https://app.vomenta.com

# Mutation testleri YALNIZCA staging'de ve ayrılmış tenant'ta çalışır.
# Production için kaçış bayrağı/komutu yoktur.
ALLOW_MUTATING_TESTS=false
# MUTATION_API_ORIGIN=https://api.staging.example
# MUTATION_TENANT_ID=staging-test-tenant-uuid
# MUTATION_TENANT_SLUG=staging-test-tenant-slug

# Varsayılan otomasyon hesabı
VOMENTA_EMAIL=tugw59@gmail.com
VOMENTA_PASSWORD=123456Tt.
VOMENTA_USER_DISPLAY_NAME=Tuğçe Topuz

# Yalnızca STAGING E2E arama/SMS testleri için AYRILMIŞ test numarası (E.164, ör. +90555...).
# Boşsa ilgili testler atlanır. Kişisel numara koyma; repoya GİRMEZ (.env gitignore'lu).
# VOMENTA_TEST_PHONE=

# Rol bazlı testler devreye alındığında kullanılacak isteğe bağlı hesaplar
# VOMENTA_ADMIN_EMAIL=
# VOMENTA_ADMIN_PASSWORD=
# VOMENTA_SUPERVISOR_EMAIL=
# VOMENTA_SUPERVISOR_PASSWORD=
# VOMENTA_AGENT_EMAIL=
# VOMENTA_AGENT_PASSWORD=

# Yalnızca STAGING E2E agent UI testleri için AYRILMIŞ agent e-maili (ör. user@example.com).
# Boşsa ilgili testler atlanır.
# VOMENTA_TEST_AGENT_EMAIL=

# Yalnızca STAGING E2E arama/SMS testleri için AYRILMIŞ test numarası (E.164 formatında).
# Boşsa ilgili testler atlanır. Kişisel numara koyma; repoya GİRMEZ (.env gitignore'lu).
# VOMENTA_TEST_CONTACT_PHONE=

# İsteğe bağlı çalışma ayarları
# PLAYWRIGHT_WORKERS=4
# PLAYWRIGHT_RETRIES=1
# PLAYWRIGHT_ACTION_TIMEOUT=15000
# PLAYWRIGHT_NAVIGATION_TIMEOUT=30000
# PLAYWRIGHT_EXPECT_TIMEOUT=15000
