# ============================================================================
# DEV ortamı şablonu (app.dev.vomenta.com).
# Bu dosyayı `.env.dev` olarak kopyalayıp DEV TEST hesabınızın bilgilerini girin.
# `.env.dev` gitignore'ludur; repoya GİRMEZ.
#
# Çalıştırma:  npm run test:dev            (tüm authed suite, dev'e karşı)
#              npm run test:dev:smoke      (yalnız @smoke)
# Bu scriptler TEST_ENV=dev'i otomatik ayarlar; BASE_URL'i config/environments.js
# içindeki dev kaydından (https://app.dev.vomenta.com) alır — elle yazmanıza gerek yok.
#
# ÖNEMLİ: Dev yalnızca ŞİRKET VPN'i ile erişilebilir. VPN bağlı değilken testler
# ağ hatası verir. Bu yüzden dev suite CI'da (GitHub-hosted runner) çalışmaz;
# lokal + VPN'de koşulur (bkz. ENVIRONMENTS.md).
# ============================================================================

TEST_ENV=dev
# BASE_URL=https://app.dev.vomenta.com   # yalnızca override gerekiyorsa

# Dev TEST hesabı — production admin hesabınızdan AYRIDIR.
VOMENTA_EMAIL=
VOMENTA_PASSWORD=
# Dev hesabının başlıkta görünen adı (AppShell doğrulaması için — prod'dan farklı olabilir).
VOMENTA_USER_DISPLAY_NAME=

# Güvenli varsayılan: dev'de de yazma KAPALI (salt-okunur). Dev'de mutation açmak
# ileride bilinçli bir adımdır (config/environments.js dev.mutable=true + dev tenant
# guard). Şimdilik false bırakın; bkz. ENVIRONMENTS.md → "Dev'de yazma".
ALLOW_MUTATING_TESTS=false
