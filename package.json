{
  "name": "vomenta-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Vomenta için Playwright uçtan uca test paketi",
  "scripts": {
    "pretest": "npm run quality:architecture",
    "test": "playwright test --project=chromium --grep @smoke",
    "pretest:smoke": "npm run quality:architecture",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "pretest:smoke:auth": "npm run quality:architecture",
    "test:smoke:auth": "playwright test --project=chromium-authed --grep @smoke",
    "pretest:critical": "npm run quality:architecture",
    "test:critical": "playwright test --project=chromium-authed --grep @critical",
    "pretest:auth": "npm run quality:architecture",
    "test:auth": "playwright test --project=chromium-authed",
    "pretest:regression": "npm run quality:architecture",
    "test:regression": "playwright test --project=chromium-authed",
    "pretest:mutation": "npm run quality:architecture",
    "test:mutation": "ALLOW_MUTATING_TESTS=true playwright test --project=chromium-authed --grep @mutation --retries=0 --workers=1",
    "pretest:prod": "npm run quality:architecture",
    "test:prod": "TEST_ENV=production playwright test --project=chromium-authed",
    "pretest:prod:smoke": "npm run quality:architecture",
    "test:prod:smoke": "TEST_ENV=production playwright test --project=chromium-authed --grep @smoke",
    "pretest:dev": "npm run quality:architecture",
    "test:dev": "TEST_ENV=dev playwright test --project=chromium-authed",
    "pretest:dev:smoke": "npm run quality:architecture",
    "test:dev:smoke": "TEST_ENV=dev playwright test --project=chromium-authed --grep @smoke",
    "prereport:orphans": "npm run quality:architecture",
    "report:orphans": "ALLOW_MUTATING_TESTS=true playwright test tests/mutation-orphans.authed.spec.js --project=chromium-authed --retries=0 --workers=1",
    "pretest:e2e": "npm run quality:architecture",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug --project=chromium",
    "test:list": "playwright test --list",
    "test:report": "playwright show-report",
    "test:install": "playwright install",
    "test:a11y": "playwright test --project=chromium-authed --grep @a11y",
    "test:layout": "playwright test --project=chromium-authed --grep @layout",
    "test:visual": "RUN_VISUAL_TESTS=true playwright test --grep @visual",
    "test:quality:pr": "playwright test tests/quality-baseline.authed.spec.js --project=chromium-authed --retries=0 --workers=1",
    "pretest:routes:baseline": "npm run quality:architecture",
    "test:routes:baseline": "playwright test tests/registered-routes-smoke.authed.spec.js --project=chromium-authed --workers=2",
    "test:perf": "playwright test --project=chromium-authed --grep @perf",
    "test:data": "playwright test --project=chromium-authed --grep @data",
    "test:errorpath": "playwright test --project=chromium-authed --grep @errorpath",
    "pretest:discovery": "npm run quality:architecture",
    "test:discovery": "playwright test --project=chromium-discovery --retries=0 --workers=1",
    "test:discovery:update-baseline": "DISCOVERY_UPDATE_BASELINE=true playwright test --project=chromium-discovery --retries=0 --workers=1",
    "report:discovery:baseline": "node tools/update-discovery-baseline.mjs",
    "quality:architecture": "node tools/validate-architecture.mjs",
    "quality:mutation-safety": "node tools/self-check-mutation-safety.mjs",
    "quality:discovery-safety": "node tools/self-check-discovery.mjs",
    "quality:artifact-safety": "node tools/self-check-artifact-safety.mjs",
    "quality:findings": "node tools/self-check-findings.mjs",
    "quality:forensic": "node tools/self-check-forensic.mjs",
    "quality:verify": "node tools/self-check-verification.mjs",
    "quality:auth-retry": "node tools/self-check-auth-retry.mjs",
    "quality:styles": "node tools/style-coverage.mjs",
    "quality:security": "node tools/self-check-security.mjs",
    "quality:artifact-allowlist": "node tools/self-check-artifact-allowlist.mjs",
    "quality:routes-baseline": "node tools/self-check-routes-baseline.mjs",
    "quality:ci-impact": "node tools/self-check-pr-impact.mjs",
    "quality:ci-runner": "node tools/self-check-pr-impact-runner.mjs",
    "quality:ci-workflow": "node tools/self-check-ci-workflow.mjs",
    "ci:impact:plan": "node tools/plan-pr-impact.mjs",
    "ci:impact:run": "node tools/run-pr-impact.mjs",
    "quality:runtime-report": "node tools/self-check-runtime-report.mjs",
    "quality:audit-orchestrator": "node tools/self-check-audit-orchestrator.mjs",
    "quality:report-history": "node tools/self-check-report-history.mjs",
    "quality:runtime-provenance": "node tools/self-check-runtime-provenance.mjs",
    "quality:delivery": "node tools/self-check-morning-delivery.mjs",
    "quality:surface": "node tools/self-check-surface-depth.mjs",
    "quality:executive": "node tools/self-check-executive-report.mjs",
    "quality:readonly-manifest": "node tools/self-check-readonly-manifest.mjs",
    "quality:surface-registry": "node tools/self-check-surface-registry.mjs",
    "quality:surface-completeness": "node tools/self-check-surface-completeness.mjs",
    "quality:surface-inventory": "node tools/self-check-surface-inventory.mjs",
    "quality:unified-report": "node tools/self-check-unified-report.mjs",
    "ci:readonly:select": "node tools/select-readonly-tests.mjs",
    "ci:audit": "node tools/run-audit.mjs",
    "quality:audit-workflow": "node tools/self-check-audit-workflow.mjs",
    "quality:audit-ci": "node tools/self-check-audit-ci.mjs",
    "report:history:append": "node tools/append-runtime-history.mjs",
    "report:archive": "node tools/archive-run.mjs",
    "quality:check": "npm run quality:architecture && npm run quality:routes-baseline && npm run quality:ci-impact && npm run quality:ci-runner && npm run quality:ci-workflow && npm run quality:audit-workflow && npm run quality:audit-ci && npm run quality:readonly-manifest && npm run quality:surface-registry && npm run quality:surface-completeness && npm run quality:surface-inventory && npm run quality:unified-report && npm run quality:runtime-report && npm run quality:audit-orchestrator && npm run quality:report-history && npm run quality:runtime-provenance && npm run quality:delivery && npm run quality:surface && npm run quality:executive && npm run quality:mutation-safety && npm run quality:discovery-safety && npm run quality:artifact-safety && npm run quality:findings && npm run quality:forensic && npm run quality:verify && npm run quality:auth-retry && npm run quality:artifact-allowlist && npm run quality:styles && npm run quality:security",
    "report:coverage": "node tools/generate-coverage.mjs",
    "report:coverage:check": "node tools/generate-coverage.mjs && git diff --exit-code -- docs/TEST_COVERAGE.md",
    "report:style-matrix": "node tools/style-coverage.mjs",
    "report:style-matrix:check": "node tools/style-coverage.mjs && git diff --exit-code -- docs/TEST_STYLE_MATRIX.md",
    "report:findings": "node tools/generate-findings.mjs",
    "report:test-report": "node tools/generate-test-report.mjs",
    "report:runtime": "node tools/generate-runtime-report.mjs",
    "report:surface": "node tools/generate-surface-depth.mjs",
    "report:surface:check": "node tools/generate-surface-depth.mjs && git diff --exit-code -- docs/SURFACE-DEPTH-MATRIX.md docs/raporlar/SURFACE-DEPTH.json",
    "report:surface-inventory": "node tools/generate-surface-inventory.mjs",
    "report:surface-inventory:check": "node tools/generate-surface-inventory.mjs && git diff --exit-code -- docs/SURFACE-INVENTORY.md docs/raporlar/SURFACE-INVENTORY.json",
    "report:project-status": "node tools/generate-project-status.mjs",
    "report:project-status:check": "node tools/generate-project-status.mjs && git diff --exit-code -- docs/PROJECT-STATUS.md docs/raporlar/PROJECT-STATUS.json",
    "report:all": "npm run report:surface-inventory && npm run report:surface && npm run report:style-matrix && npm run report:project-status && npm run quality:unified-report",
    "report:executive": "node tools/generate-executive-report.mjs",
    "report:executive:check": "node tools/generate-executive-report.mjs && git diff --exit-code -- docs/raporlar/YONETICI-OZET.json docs/raporlar/YONETICI-OZET.md",
    "report:readonly-manifest": "node tools/generate-readonly-manifest.mjs",
    "report:readonly-manifest:check": "node tools/generate-readonly-manifest.mjs && git diff --exit-code -- docs/raporlar/READONLY-MANIFEST.json docs/raporlar/READONLY-MANIFEST.md",
    "delivery:morning": "node tools/run-morning-delivery.mjs",
    "report:build": "npm run report:findings && npm run report:test-report",
    "report:pdf": "npm run report:build && node tools/render-report-pdf.mjs",
    "report:findings:check": "npm run report:build && git diff --exit-code -- docs/raporlar/findings.json docs/raporlar/BULGULAR.md docs/raporlar/YAPILAN-TESTLER.md docs/raporlar/YAPILMAYAN-TESTLER.md",
    "report:bug": "node tools/report-bug.mjs",
    "report:artifact": "node tools/prepare-forensic-artifact.mjs",
    "report:artifact:prepare": "node tools/prepare-ci-artifact.mjs",
    "report:reconcile": "node tools/reconcile-known-bugs.mjs",
    "report:verify": "node tools/verify-fixed-candidate.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.62.0",
    "@types/node": "^26.1.1",
    "dotenv": "^17.4.2"
  }
}
